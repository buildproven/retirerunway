# RetireRunway Environment Variables
# Copy this file to .env.local and fill in your values

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key used by Stripe subscription persistence. Never expose this
# value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server-side only, used when no BYOK key provided) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Stripe (Item #25 — leave blank until configured) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
# Optional comma-separated allowlist; defaults to STRIPE_PRO_PRICE_ID.
STRIPE_ALLOWED_PRICE_IDS=
# Keep both false until the Supabase migration and webhook secret are deployed.
SUBSCRIPTIONS_READY=false
SUBSCRIPTIONS_ENABLED=false

# --- Plaid (Item #28 — leave blank until configured) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Email (Resend for onboarding emails) ---
RESEND_API_KEY=

# --- Supabase Webhook (for auth events) ---
# Generate a secret for webhook verification
SUPABASE_WEBHOOK_SECRET=

# --- Public API access (/api/v1/*) ---
# Comma-separated bearer tokens accepted by /api/v1/analyze and /api/v1/tax.
# REQUIRED to serve those routes: they fail closed (503) when this is unset,
# so a deploy that forgets it breaks loudly instead of becoming public.
API_ACCESS_KEYS=

# Local development only: serve /api/v1/* without a token. Ignored when
# NODE_ENV=production, so it can never open a live deployment.
ALLOW_UNAUTHENTICATED_API=
